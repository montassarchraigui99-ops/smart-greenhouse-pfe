# ============================================
# CYBERCORTEX ERP - CONFIGURATION ENVIRONNEMENT
# ============================================

# --------------------------------------------
# 1. INTELLIGENCE ARTIFICIELLE & CHATBOT GEMINI
# --------------------------------------------
# Clé API Google Gemini pour l'assistant conversationnel
# Obtenez votre clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modèle Gemini recommandé : gemini-1.5-flash ou gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------
# 2. DISPATCHER E-MAIL AUTOMATISÉ (SMTP / NODEMAILER)
# --------------------------------------------
# Serveur SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, smtp.office365.com, mail.votre-domaine.com)
SMTP_HOST=smtp.gmail.com

# Port SMTP : 587 (STARTTLS / standard recommandé) ou 465 (SSL/TLS direct)
SMTP_PORT=587

# Connexion sécurisée SSL directe : true pour port 465, false pour port 587
SMTP_SECURE=false

# Nom d'utilisateur SMTP ou adresse e-mail de l'expéditeur
SMTP_USER=

# Mot de passe SMTP ou mot de passe d'application (App Password pour Gmail avec 2FA)
SMTP_PASS=

# En-tête de l'expéditeur affiché aux destinataires
SMTP_FROM="CyberCortex ERP - Alert Engine" <alerts@cybercortex.local>

# E-mail de secours par défaut si aucun profil actif n'est détecté
DEFAULT_ALERT_EMAIL=montassarchraigui99@gmail.com

# --------------------------------------------
# 3. INTERFACE OPÉRATEUR & JUMEAU NUMÉRIQUE (CTA)
# --------------------------------------------
# URL racine du tableau de bord / Jumeau Numérique pour les liens d'action dans les e-mails
DASHBOARD_URL=http://localhost:8081
